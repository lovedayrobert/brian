# Brian environment. Copy to .env.local and fill in what you have.
# Missing keys switch features off, never break the app.

# --- Login (required in production; optional for local development) ---
# Comma-separated name:password pairs. Use long random passwords.
BRIAN_USERS=
# 32+ random characters, e.g. `openssl rand -hex 32`
BRIAN_SESSION_SECRET=

# --- Hard AI spend caps in USD (defaults: 50 a day, 300 a month) ---
BRIAN_DAILY_CAP_USD=50
BRIAN_MONTHLY_CAP_USD=300

# --- Partner feeds: bearer token for POST /api/ingest (32+ characters) ---
BRIAN_INGEST_TOKEN=

# --- AI (turns on ideas, Critic, Red Lines, packages, Rapid Response) ---
# Max and Team plans include monthly API credits: link a Console org in your plan's billing settings and create the key there.
ANTHROPIC_API_KEY=

# --- Images and video (fal.ai: one key for both). Without it, code formats still render
# and image formats show their art direction. Costs are charged against the spend cap.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1-ultra
FAL_IMAGE_COST_USD=0.06
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/turbo/standard/text-to-video
FAL_VIDEO_COST_USD=0.6
# Legacy single key visual (OpenAI); superseded by fal.ai
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# --- Free sources that need a key ---
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ETHERSCAN_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- Paid sources (slots ready; adapters added once budget is approved) ---
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SERPAPI_KEY=
NEWS_API_KEY=
SOCIAL_LISTENING_KEY=
META_ACCESS_TOKEN=
DUNE_API_KEY=
ARKHAM_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
APIFY_TOKEN=

# --- Handover and alerts ---
LINEAR_API_KEY=
LINEAR_TEAM_ID=
SLACK_WEBHOOK_URL=
