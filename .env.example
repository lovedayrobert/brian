# Brian environment. Copy to .env.local and fill in what you have.
# Everything is optional: missing keys switch features off, never break the app.

# --- AI (turns on ideas, Critic, Red Lines, packages, Rapid Response) ---
ANTHROPIC_API_KEY=

# --- Images (key visuals). Without it, mockups use code-built brand visuals ---
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# --- Free sources that need a key ---
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ETHERSCAN_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- Paid sources (slots ready; adapters added once budget is approved) ---
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SERPAPI_KEY=
NEWS_API_KEY=
SOCIAL_LISTENING_KEY=
META_ACCESS_TOKEN=
DUNE_API_KEY=
ARKHAM_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
APIFY_TOKEN=

# --- Handover and alerts ---
LINEAR_API_KEY=
LINEAR_TEAM_ID=
SLACK_WEBHOOK_URL=
